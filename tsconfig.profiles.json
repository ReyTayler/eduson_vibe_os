{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "profiles",
    "outDir": "dist/profiles",
    "declaration": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "profiles/**/*.ts"
  ]
}
