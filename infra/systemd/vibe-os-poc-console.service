[Unit]
Description=Vibe OS SSH-only prototype console
After=local-fs.target
StartLimitIntervalSec=30
StartLimitBurst=3
RequiresMountsFor=/srv/vibe-os/data

[Service]
ExecStart=/usr/local/bin/node /opt/vibe-os/poc-hosting/console.mjs
User=vibe-poc-control
Group=vibe-poc-control
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
MemorySwapMax=0
TasksMax=32

[Install]
WantedBy=multi-user.target
