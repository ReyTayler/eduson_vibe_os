[Unit]
Description=Renew Vibe OS short-lived IP TLS certificate
[Service]
Type=oneshot
ExecStart=/opt/vibe-os/certbot/bin/certbot renew --quiet --no-random-sleep-on-renew --deploy-hook /opt/vibe-os/bin/reload-portal-tls
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/lib/vibe-os/acme /run/vibe-os-portal-web /var/log/nginx/error.log
