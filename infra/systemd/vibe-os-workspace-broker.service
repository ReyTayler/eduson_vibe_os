[Unit]
Description=Vibe OS typed student workspace and Harness coordinator
After=vibe-os-workspace-runner.service vibe-os-model-gateway.service
Requires=vibe-os-workspace-runner.service
Wants=vibe-os-model-gateway.service
RequiresMountsFor=/srv/vibe-os/data
[Service]
ExecStart=/usr/local/bin/node /opt/vibe-os/portal-broker/server.mjs
User=root
RuntimeDirectory=vibe-os-portal
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=20
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/vibe-os/data/student-projects /etc/vibe-os/student-projects /var/lib/vibe-os/student-registry /var/lib/vibe-os/portal-broker /run/vibe-os-portal /sys/fs/cgroup
MemoryMax=256M
MemorySwapMax=0
TasksMax=128
[Install]
WantedBy=multi-user.target
